# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# Persistent SQLite Storage
DATABASE_URL=sqlite:///./workbench.db

# Authentication (Keycloak OIDC & SAML Identity Brokering)
DEMO_MODE=true
OIDC_ISSUER=http://127.0.0.1:8080/realms/workbench-realm
OIDC_CLIENT_ID=workbench-client
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=workbench-client
OIDC_DISCOVERY_URL=http://127.0.0.1:8080/realms/workbench-realm/.well-known/openid-configuration

# Advisory LLM Configuration (Optional server-side assistance)
LLM_PROVIDER=openai-compatible
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
