{
  "realm": "workbench-realm",
  "enabled": true,
  "displayName": "Signal Workbench Realm",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Administrator role with full control"
      },
      {
        "name": "operator",
        "description": "Operator role with model inference and benchmarking control"
      },
      {
        "name": "viewer",
        "description": "Read-only viewer role"
      }
    ]
  },
  "clients": [
    {
      "clientId": "workbench-client",
      "name": "Signal Workbench Client",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1:3000/*",
        "http://127.0.0.1:8000/*"
      ],
      "webOrigins": [
        "http://127.0.0.1:3000",
        "http://127.0.0.1:8000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://127.0.0.1:3000/*##http://127.0.0.1:8000/*"
      }
    }
  ],
  "identityProviders": [
    {
      "alias": "enterprise-saml-idp",
      "displayName": "Enterprise SAML Identity Provider",
      "providerId": "saml",
      "enabled": false,
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "authenticateByDefault": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "nameIDPolicyFormat": "urn:oasis:names:tc:SAML:2.0:nameid-format:persistent",
        "singleSignOnServiceUrl": "https://idp.example.com/saml/sso",
        "wantAuthnRequestsSigned": "true",
        "wantAssertionsSigned": "true",
        "signatureAlgorithm": "RSA_SHA256"
      }
    }
  ]
}
